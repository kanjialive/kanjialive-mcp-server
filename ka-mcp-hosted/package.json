{
  "name": "ka-mcp-hosted",
  "version": "1.1.2",
  "description": "TypeScript MCP server for Kanji Alive API - HTTP transport for Railway hosting",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/data dist/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "kanji",
    "japanese",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
